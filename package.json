{
  "name": "proximity-effect",
  "version": "4.0.0",
  "type": "module",
  "description": "Mass animate CSS properties based on proximity of mouse or arbitrary target.",
  "author": {
    "name": "Adam Shailer",
    "email": "adasha76@outlook.com",
    "url": "http://adasha.com"
  },
  "exports": {
    ".": {
      "types": "./dist/proximity-effect.d.ts",
      "default": "./dist/proximity-effect.mjs"
    },
    "./global": {
      "types": "./dist/proximity-effect.global.d.ts"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/proximity-effect.mjs",
  "types": "./dist/proximity-effect.d.ts",
  "unpkg": "./dist/proximity-effect.min.js",
  "jsdelivr": "./dist/proximity-effect.min.js",
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "keywords": [
    "mouse",
    "movement",
    "track",
    "tracker",
    "tracking",
    "distance",
    "range",
    "proximity",
    "nearness",
    "closeness",
    "position",
    "approach",
    "interpolate",
    "interpolation",
    "visual",
    "eye-candy",
    "effect",
    "filter",
    "overlay",
    "fader",
    "CSS",
    "style",
    "stylesheet",
    "animate",
    "animation",
    "tween",
    "tweening",
    "blend",
    "transform",
    "transition",
    "element",
    "front-end"
  ],
  "homepage": "http://lab.adasha.com/components/proximity-effect",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adasha/proximity-effect"
  },
  "bugs": {
    "url": "https://github.com/Adasha/proximity-effect/issues",
    "email": "adasha76@outlook.com"
  },
  "license": "MPL-2.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "a11y": "node scripts/a11y.js",
    "bench": "node scripts/bench.js",
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tests/types"
  },
  "allowScripts": {
    "esbuild": false
  }
}
